  resolveProfileModel,
  resolveLocalFallback,
  resolveLlmMode,
  normalizeLlmMode,
  baseModeFor,
  resolveActiveTier,
  resolveCapabilityAlias,
  matchModelRoute,
  pickModeTarget,
  parseBackendSigil,
  expandLatestModel,
  LLM_MODE_ENUM,
  applyModeFilter,
  filterFor,
  validModes,

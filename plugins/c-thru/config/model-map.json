      "vertex": true,
      "fallback_to": "sonnet"
    },
    "anthropic_subscription": {
      "url": "https://api.anthropic.com",
      "format": "anthropic",
      "auth": "subscription"
    },
    "xai": {
      "url": "https://api.x.ai",
      "format": "openai",
      "auth": {
        "header": "Authorization",
        "scheme": "Bearer",
        "env": "XAI_API_KEY"

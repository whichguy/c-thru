#!/usr/bin/env bash
# Pre-push: full hermetic suite (fast tier) so a regression can't leave this machine.
# Commit runs the cheap contract gate; push runs the broad net. Override: git push --no-verify.
#
# Auto-detected via core.hooksPath=.githooks. --fast skips the exclusive lock
# (concurrency-safe) and the slow e2e/smoke suites; it still runs the contract
# harness + guards-bite + gate-coverage that the cheap commit gate cannot.
set -o pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
if [ -f "$REPO_ROOT/test/run-all.sh" ]; then
  bash "$REPO_ROOT/test/run-all.sh" --fast || { echo "pre-push: test/run-all.sh --fast failed — fix before pushing"; exit 1; }
fi

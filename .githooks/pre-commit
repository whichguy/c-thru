#!/usr/bin/env bash
# Pre-commit: verify plugins/c-thru/ bundle is in sync with source files,
# and run baseline syntax/schema checks.
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ -f "$REPO_ROOT/tools/sync-plugin-bundle.sh" ]; then
  bash "$REPO_ROOT/tools/sync-plugin-bundle.sh" --check || {
    echo "Run: tools/sync-plugin-bundle.sh"
    exit 1
  }
fi

# The README "Agent routing reference" table is a derived artifact of config/model-map.json.
# Fail closed if config changed without regenerating it (else it silently drifts).
if [ -f "$REPO_ROOT/tools/gen-routing-doc.js" ]; then
  node "$REPO_ROOT/tools/gen-routing-doc.js" --check || {
    echo "Run: node tools/gen-routing-doc.js"
    exit 1
  }
fi

bash -n "$REPO_ROOT/tools/c-thru" || { echo "bash syntax error in tools/c-thru"; exit 1; }
node --check "$REPO_ROOT/tools/claude-proxy" || { echo "node syntax error in tools/claude-proxy"; exit 1; }
node "$REPO_ROOT/tools/model-map-validate.js" "$REPO_ROOT/config/model-map.json" || {
  echo "model-map.json schema validation failed"
  exit 1
}

# Agent/skill contract check + its guard-bite meta-test. Cheap (~3s + ~13s) and
# deterministic, so they run at commit. The broad hermetic suite (incl. the
# contract-check harness that exercises the REPO_DIR rewrite) runs at pre-push.
if [ -f "$REPO_ROOT/tools/c-thru-contract-check.sh" ]; then
  bash "$REPO_ROOT/tools/c-thru-contract-check.sh" || { echo "agent/skill contract check failed (tools/c-thru-contract-check.sh)"; exit 1; }
fi
if [ -f "$REPO_ROOT/test/contract-check-guards-bite.test.sh" ]; then
  bash "$REPO_ROOT/test/contract-check-guards-bite.test.sh" || { echo "contract-check guard-bite meta-test failed — a fail-loud guard stopped biting"; exit 1; }
fi
